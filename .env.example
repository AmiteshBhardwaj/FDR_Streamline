DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Development generates private keys in .local/secrets.json automatically.
# Production requires independent secrets and encrypted deployment volumes:
# DJANGO_SECRET_KEY=at-least-40-cryptographically-random-characters
# DOCUMENT_ENCRYPTION_KEY=base64-url-safe-encoded-32-random-bytes
# DATABASE_URL=postgresql://portal:password@localhost:5432/portal?sslmode=require
# PRIVATE_STORAGE_ROOT=/srv/fdr/documents
# CSRF_TRUSTED_ORIGINS=https://fdr.example.org
# TRUST_PROXY_HTTPS=true  # Only behind a proxy that replaces X-Forwarded-Proto.
SMTP_ENABLED=false
# EMAIL_HOST=smtp.example.org
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=portal@example.org
